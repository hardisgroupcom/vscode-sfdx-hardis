[
  {
    "key": "picklists",
    "title": "Picklists",
    "description": "Changes picklist values in ways the Metadata API cannot:\n\n- replace a value by another one in the records using it, then deactivate or delete the old value;\n- activate or deactivate values;\n- manage (create, modify, delete) the field dependencies of custom fields. An existing field dependency of the dependent field is deleted first.",
    "docUrl": "https://amtrack.github.io/sfdx-browserforce-plugin/settings/picklists/",
    "jsonSchema": {
      "type": "object",
      "properties": {
        "picklistValues": {
          "default": [],
          "title": "Picklist Values",
          "description": "Replace (and delete) picklist values",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metadataType": {
                "type": "string",
                "enum": [
                  "CustomField",
                  "GlobalValueSet",
                  "StandardValueSet"
                ],
                "description": "the metadata type"
              },
              "metadataFullName": {
                "type": "string",
                "description": "the API name of the CustomField/GlobalValueSet/StandardValueSet"
              },
              "value": {
                "type": "string",
                "description": "the API name of the value"
              },
              "newValue": {
                "type": "string",
                "description": "the API name of the new value, otherwise blank"
              },
              "statusCategory": {
                "type": "string",
                "description": "the Status Category of a new picklist value"
              },
              "replaceAllBlankValues": {
                "type": "boolean",
                "description": "replace all blank values (mutually exclusive to replacing an old value)"
              },
              "active": {
                "type": "boolean",
                "description": "ensure the picklist value is active/inactive"
              },
              "absent": {
                "type": "boolean",
                "description": "ensure the picklist value is absent/deleted"
              }
            },
            "required": [
              "metadataType",
              "metadataFullName"
            ]
          }
        },
        "fieldDependencies": {
          "default": [],
          "description": "Manage (create/modify/delete) Field Dependencies on CustomFields.\nIf a Field Dependency already exists for the dependent field, it will be deleted.",
          "title": "Field Dependencies",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "object": {
                "type": "string",
                "title": "the API name of the CustomObject",
                "examples": [
                  "Account",
                  "Vehicle__c",
                  "ACME__Vehicle__c"
                ]
              },
              "dependentField": {
                "type": "string",
                "title": "the API name of the CustomField that has its values filtered",
                "examples": [
                  "Gears__c",
                  "ACME__Gears__c"
                ]
              },
              "controllingField": {
                "title": "the API name of the CustomField that drives filtering",
                "description": "If this value is null or not set, the Field Dependency will be deleted.",
                "examples": [
                  "Transmission__c",
                  "ACME__Transmission__c",
                  null
                ],
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "title": "Picklists",
      "description": "Changes picklist values in ways the Metadata API cannot:\n\n- replace a value by another one in the records using it, then deactivate or delete the old value;\n- activate or deactivate values;\n- manage (create, modify, delete) the field dependencies of custom fields. An existing field dependency of the dependent field is deleted first.",
      "examples": [
        {
          "picklistValues": [
            {
              "metadataType": "StandardValueSet",
              "metadataFullName": "LeadSource",
              "value": "Phone Inquiry",
              "newValue": "Other"
            }
          ]
        },
        {
          "picklistValues": [
            {
              "metadataType": "StandardValueSet",
              "metadataFullName": "LeadSource",
              "value": "Purchased List",
              "newValue": "Other",
              "absent": true
            }
          ]
        },
        {
          "picklistValues": [
            {
              "metadataType": "CustomField",
              "metadataFullName": "Account.MyPicklist__c",
              "value": "MyOldValue",
              "active": false
            }
          ]
        }
      ]
    },
    "groups": [
      {
        "path": "picklistValues[]",
        "kind": "array",
        "title": "Picklist Values",
        "description": "Replace (and delete) picklist values"
      },
      {
