        "title": "the API name of the CustomField that has its values filtered",
        "required": false,
        "isPassword": false,
        "isIrreversible": false
      },
      {
        "path": "fieldDependencies[].controllingField",
        "group": "fieldDependencies[]",
        "type": "json",
        "title": "the API name of the CustomField that drives filtering",
        "description": "If this value is null or not set, the Field Dependency will be deleted.",
        "required": false,
        "isPassword": false,
        "isIrreversible": false
      }
    ],
    "examples": [
      {
        "picklistValues": [
          {
            "metadataType": "StandardValueSet",
            "metadataFullName": "LeadSource",
            "value": "Phone Inquiry",
            "newValue": "Other"
          }
        ]
      },
      {
        "picklistValues": [
          {
            "metadataType": "StandardValueSet",
            "metadataFullName": "LeadSource",
            "value": "Purchased List",
            "newValue": "Other",
            "absent": true
          }
        ]
      },
      {
        "picklistValues": [
          {
            "metadataType": "CustomField",
            "metadataFullName": "Account.MyPicklist__c",
            "value": "MyOldValue",
            "active": false
          }
        ]
      }
    ],
    "warnings": {
