  {
    "key": "userAccessPolicies",
    "title": "User Access Policies",
    "description": "Setup: **Users → User Access Policies** (`/lightning/setup/UserAccessPolicies/home`)\n\nActivates or deactivates User Access Policies, chooses when they run (on create, update, or both), and runs Apply To All.",
    "docUrl": "https://amtrack.github.io/sfdx-browserforce-plugin/settings/userAccessPolicies/",
    "jsonSchema": {
      "type": "object",
      "properties": {
        "accessPolicies": {
          "default": [],
          "title": "Access Policies",
          "description": "List of user access policies to activate, deactivate or apply to all users",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "apiName": {
                "type": "string",
                "description": "The API name of the user access policy (e.g., 'Grant_Permissions')"
              },
              "active": {
                "type": "boolean",
                "description": "Whether the policy should be active (true) or inactive (false). Leave it out to keep the current status of the policy."
              },
              "on": {
                "type": "string",
                "enum": [
                  "Create",
                  "Update",
                  "CreateAndUpdate"
                ],
                "description": "Optional: specify when to apply the policy - 'Create', 'Update', or 'CreateAndUpdate'. Only used when active is true."
              },
              "applyToAll": {
                "type": "boolean",
                "title": "Apply To All",
                "x-irreversible": true,
                "description": "Run Apply To All once the policy is set: assigns its access to every user matching its criteria. Runs Apply To All at each apply: Salesforce keeps no state that tells it already ran. A run cannot be undone."
              }
            },
            "required": [
              "apiName"
            ]
          }
        }
      },
      "title": "User Access Policies",
      "description": "Setup: **Users → User Access Policies** (`/lightning/setup/UserAccessPolicies/home`)\n\nActivates or deactivates User Access Policies, chooses when they run (on create, update, or both), and runs Apply To All.",
      "examples": [
        {
          "accessPolicies": [
            {
              "apiName": "Grant_Permissions",
              "active": true,
              "on": "Create"
            }
          ]
        },
        {
          "accessPolicies": [
            {
              "apiName": "Grant_Permissions",
              "active": true,
              "on": "Create",
              "applyToAll": true
            }
          ]
        },
        {
          "accessPolicies": [
            {
              "apiName": "Grant_Permissions",
              "applyToAll": true
            }
          ]
        }
      ],
      "x-prerequisites": [
        "User Access Policies enabled (User Management Settings)"
      ]
    },
    "groups": [
      {
        "path": "accessPolicies[]",
        "kind": "array",
        "title": "Access Policies",
        "description": "List of user access policies to activate, deactivate or apply to all users"
      }
    ],
    "fields": [
      {
        "path": "accessPolicies[].apiName",
        "group": "accessPolicies[]",
        "type": "string",
        "description": "The API name of the user access policy (e.g., 'Grant_Permissions')",
        "required": true,
        "isPassword": false,
        "isIrreversible": false
      },
      {
        "path": "accessPolicies[].active",
        "group": "accessPolicies[]",
        "type": "boolean",
        "description": "Whether the policy should be active (true) or inactive (false). Leave it out to keep the current status of the policy.",
        "required": false,
        "isPassword": false,
        "isIrreversible": false
      },
      {
        "path": "accessPolicies[].on",
        "group": "accessPolicies[]",
        "type": "string",
        "description": "Optional: specify when to apply the policy - 'Create', 'Update', or 'CreateAndUpdate'. Only used when active is true.",
        "required": false,
        "enum": [
          "Create",
          "Update",
          "CreateAndUpdate"
        ],
        "isPassword": false,
        "isIrreversible": false
      },
      {
        "path": "accessPolicies[].applyToAll",
        "group": "accessPolicies[]",
        "type": "boolean",
        "title": "Apply To All",
        "description": "Run Apply To All once the policy is set: assigns its access to every user matching its criteria. Runs Apply To All at each apply: Salesforce keeps no state that tells it already ran. A run cannot be undone.",
        "required": false,
        "isPassword": false,
        "isIrreversible": true
      }
    ],
    "examples": [
      {
        "accessPolicies": [
          {
            "apiName": "Grant_Permissions",
            "active": true,
            "on": "Create"
          }
        ]
      },
      {
        "accessPolicies": [
          {
            "apiName": "Grant_Permissions",
            "active": true,
            "on": "Create",
            "applyToAll": true
          }
        ]
      },
      {
        "accessPolicies": [
          {
            "apiName": "Grant_Permissions",
            "applyToAll": true
          }
        ]
      }
    ],
    "warnings": {
      "irreversibleFields": [
        "accessPolicies[].applyToAll"
      ],
      "userInterface": null,
      "prerequisites": [
        "User Access Policies enabled (User Management Settings)"
      ]
    }
  }
