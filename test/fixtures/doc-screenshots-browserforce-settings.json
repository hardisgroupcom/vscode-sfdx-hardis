      {
        "path": "picklistValues[].replaceAllBlankValues",
        "group": "picklistValues[]",
        "type": "boolean",
        "description": "replace all blank values (mutually exclusive to replacing an old value)",
        "required": false,
        "isPassword": false,
        "isIrreversible": false
      },
      {
        "path": "picklistValues[].active",
        "group": "picklistValues[]",
        "type": "boolean",
        "description": "ensure the picklist value is active/inactive",
        "required": false,
